# ==============================================================================
# GrowthNotes Environment Variables Example
# Duplicate this file to .env.local for local development. Never commit secrets!
# ==============================================================================

# App Configuration
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Postgres - Neon, Supabase, or Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/growthnotes?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/growthnotes?schema=public"

# Razorpay Payment Gateway (Test keys for development)
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecretHere"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"

# Secure Private File Storage (S3 / Cloudflare R2 / Supabase Storage)
STORAGE_PROVIDER="local" # 'local' | 's3' | 'r2' | 'supabase'
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET_NAME="growthnotes-private-assets"
STORAGE_ENDPOINT="" # e.g. https://<account_id>.r2.cloudflarestorage.com
STORAGE_REGION="auto"
DOWNLOAD_TOKEN_SECRET="super-secret-hex-or-string-for-token-signing-min-16-chars"

# Transactional Email (Resend)
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="GrowthNotes <downloads@growthnotes.in>"

# Admin Dashboard Access
ADMIN_SECRET_KEY="change_me_to_a_secure_admin_password_in_production"

# Performance Marketing & Tracking (GTM, Meta Pixel & Conversions API)
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
NEXT_PUBLIC_META_PIXEL_ID="123456789012345"
META_CONVERSIONS_API_TOKEN="EAAG..."
